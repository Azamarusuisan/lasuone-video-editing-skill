				"from": "00:03:14,960",
				"to": "00:03:18,560"
			},
			"offsets": {
				"from": 194960,
				"to": 198560
			},
			"text": "いいものつけてるね"
		},
		{
			"timestamps": {
				"from": "00:03:18,560",
				"to": "00:03:22,960"
			},
			"offsets": {
				"from": 198560,
				"to": 202960
			},
			"text": "これが相当当たりだわ"
		},
