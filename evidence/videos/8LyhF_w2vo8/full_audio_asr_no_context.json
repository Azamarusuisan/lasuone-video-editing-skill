				"to": "00:13:52,960"
			},
			"offsets": {
				"from": 824080,
				"to": 832960
			},
			"text": "さあにマンドル負けてはお酒バーで来ました 負けた時は酒を飲むという感じで日本人のやってるラスベガス唯一のガールズバーです"
		},
		{
			"timestamps": {
				"from": "00:13:52,960",
				"to": "00:13:55,880"
			},
			"offsets": {
				"from": 832960,
				"to": 835880
			},
			"text": "うまんガールズバーって言ってねえちょっと言われ"
		},
		{
			"timestamps": {
				"from": "00:13:55,880",
				"to": "00:13:56,960"
			},
			"offsets": {
				"from": 835880,
				"to": 836960
			},
			"text": "ドルドルじゃなくて"
