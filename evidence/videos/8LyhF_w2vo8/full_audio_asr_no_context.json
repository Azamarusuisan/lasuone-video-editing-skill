			"timestamps": {
				"from": "00:14:52,560",
				"to": "00:14:56,940"
			},
			"offsets": {
				"from": 892560,
				"to": 896940
			},
			"text": "で昨日までの結果はサイドギャンブルが15000ドル負け"
