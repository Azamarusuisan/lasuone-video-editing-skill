			"timestamps": {
				"from": "00:14:03,220",
				"to": "00:14:04,680"
			},
			"offsets": {
				"from": 843220,
				"to": 844680
			},
			"text": "はいカンパーイ"
		},
		{
			"timestamps": {
				"from": "00:14:04,680",
				"to": "00:14:05,460"
			},
			"offsets": {
				"from": 844680,
				"to": 845460
			},
			"text": "カンパーイ"
		},
		{
			"timestamps": {
				"from": "00:14:05,460",
				"to": "00:14:05,780"
			},
			"offsets": {
				"from": 845460,
				"to": 845780
			},
			"text": "カンパーイ"
		},
		{
			"timestamps": {
				"from": "00:14:05,780",
				"to": "00:14:06,720"
			},
			"offsets": {
				"from": 845780,
				"to": 846720
			},
			"text": "カンパーイ"
		},
		{
			"timestamps": {
				"from": "00:14:06,720",
				"to": "00:14:07,360"
			},
			"offsets": {
				"from": 846720,
				"to": 847360
			},
			"text": "カンパーイ"
		},
		{
			"timestamps": {
				"from": "00:14:07,360",
				"to": "00:14:08,460"
			},
			"offsets": {
				"from": 847360,
				"to": 848460
			},
			"text": "カンパーイ"
		},
		{
			"timestamps": {
				"from": "00:14:08,460",
				"to": "00:14:10,640"
			},
			"offsets": {
				"from": 848460,
				"to": 850640
			},
			"text": "カンパーオダーニーアサケアデイ"
