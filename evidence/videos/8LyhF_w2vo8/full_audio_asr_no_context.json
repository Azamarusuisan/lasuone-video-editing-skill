			"timestamps": {
				"from": "00:12:59,120",
				"to": "00:13:00,760"
			},
			"offsets": {
				"from": 779120,
				"to": 780760
			},
			"text": "俺はちょっと修行に行きます"
		},
		{
			"timestamps": {
				"from": "00:13:00,760",
				"to": "00:13:08,120"
			},
			"offsets": {
				"from": 780760,
				"to": 788120
			},
			"text": "ラサさんこれは"
		},
		{
			"timestamps": {
				"from": "00:13:08,120",
				"to": "00:13:10,720"
			},
			"offsets": {
				"from": 788120,
				"to": 790720
			},
			"text": "これは10倍になったら"
		},
		{
			"timestamps": {
				"from": "00:13:10,720",
				"to": "00:13:11,820"
			},
			"offsets": {
				"from": 790720,
				"to": 791820
			},
			"text": "サワー抜けて2.7"
		},
		{
			"timestamps": {
				"from": "00:13:11,820",
				"to": "00:13:13,440"
			},
			"offsets": {
				"from": 791820,
				"to": 793440
			},
			"text": "ちょっとリハビリ"
		},
		{
			"timestamps": {
				"from": "00:13:13,440",
				"to": "00:13:14,080"
			},
			"offsets": {
				"from": 793440,
				"to": 794080
			},
			"text": "リハビリ"
		},
		{
			"timestamps": {
				"from": "00:13:14,080",
				"to": "00:13:17,800"
			},
			"offsets": {
				"from": 794080,
				"to": 797800
			},
			"text": "修行したサテライトも飛んで"
		},
		{
			"timestamps": {
				"from": "00:13:17,800",
				"to": "00:13:19,500"
			},
			"offsets": {
				"from": 797800,
				"to": 799500
			},
			"text": "これはクラップスですか"
		},
		{
			"timestamps": {
				"from": "00:13:19,500",
				"to": "00:13:20,240"
			},
			"offsets": {
				"from": 799500,
				"to": 800240
			},
			"text": "だってやるんだ"
		},
		{
			"timestamps": {
				"from": "00:13:20,240",
				"to": "00:13:21,940"
			},
			"offsets": {
				"from": 800240,
				"to": 801940
			},
			"text": "わからん"
		},
		{
			"timestamps": {
				"from": "00:13:21,940",
				"to": "00:13:27,560"
			},
			"offsets": {
				"from": 801940,
				"to": 807560
			},
			"text": "あたりが結構多い"
		},
