			"timestamps": {
				"from": "00:14:56,940",
				"to": "00:15:00,160"
			},
			"offsets": {
				"from": 896940,
				"to": 900160
			},
			"text": "あと何気にキャバックラみたいなの行って"
		},
		{
			"timestamps": {
				"from": "00:15:00,160",
				"to": "00:15:02,740"
			},
			"offsets": {
				"from": 900160,
				"to": 902740
			},
			"text": "なんかいろいろ飯だったりとかが5000ドルくらい"
		},
		{
			"timestamps": {
				"from": "00:15:02,740",
				"to": "00:15:06,180"
			},
			"offsets": {
				"from": 902740,
				"to": 906180
			},
			"text": "メインがちょっとそろそろこれやらないんで"
		},
		{
			"timestamps": {
				"from": "00:15:06,180",
				"to": "00:15:06,920"
			},
			"offsets": {
				"from": 906180,
				"to": 906920
			},
			"text": "気まずい"
		},
		{
			"timestamps": {
				"from": "00:15:06,920",
				"to": "00:15:08,420"
			},
			"offsets": {
				"from": 906920,
				"to": 908420
			},
