				"to": "00:11:51,980"
			},
			"offsets": {
				"from": 707720,
				"to": 711980
			},
			"text": "ビデオのメーカー、去年も6機入れてて、一昨年も6機入れてて、"
		},
		{
			"timestamps": {
				"from": "00:11:51,980",
				"to": "00:11:53,860"
			},
			"offsets": {
				"from": 711980,
				"to": 713860
			},
			"text": "馬を入れると毎年10機ぐらい出てる。"
		},
		{
			"timestamps": {
				"from": "00:11:53,860",
				"to": "00:11:56,520"
			},
			"offsets": {
				"from": 713860,
				"to": 716520
			},
			"text": "1回も今の仕事ないから、あんまりこれ抜いてない。"
		},
		{
			"timestamps": {
				"from": "00:11:56,520",
				"to": "00:11:59,100"
			},
			"offsets": {
				"from": 716520,
				"to": 719100
			},
			"text": "なんで一応もうバーベキューの準備は始まります。"
		},
		{
			"timestamps": {
				"from": "00:11:59,100",
				"to": "00:12:02,280"
			},
			"offsets": {
				"from": 719100,
				"to": 722280
			},
			"text": "ただ、そう言いながらも、撮りたいなって気持ちは本当にある。"
		},
		{
			"timestamps": {
				"from": "00:12:02,280",
				"to": "00:12:03,480"
			},
			"offsets": {
				"from": 722280,
				"to": 723480
			},
			"text": "はい、ちょっと頑張っていこうか。"
		},
		{
			"timestamps": {
				"from": "00:12:17,720",
				"to": "00:12:47,700"
			},
			"offsets": {
				"from": 737720,
				"to": 767700
			},
			"text": "次回予告"
		},
		{
			"timestamps": {
				"from": "00:12:47,720",
				"to": "00:12:51,420"
			},
			"offsets": {
				"from": 767720,
				"to": 771420
			},
			"text": "めちゃめちゃ睨んでるじゃないですか"
		},
		{
			"timestamps": {
				"from": "00:12:51,420",
				"to": "00:12:51,960"
			},
			"offsets": {
				"from": 771420,
				"to": 771960
			},
			"text": "と言いました"
		},
		{
			"timestamps": {
				"from": "00:12:51,960",
				"to": "00:12:53,300"
			},
			"offsets": {
				"from": 771960,
				"to": 773300
			},
			"text": "まあでも大丈夫です"
		},
		{
			"timestamps": {
				"from": "00:12:53,300",
				"to": "00:12:54,840"
			},
			"offsets": {
				"from": 773300,
				"to": 774840
			},
			"text": "これにはもう縁がないです"
		},
		{
			"timestamps": {
				"from": "00:12:54,840",
				"to": "00:12:56,120"
			},
			"offsets": {
				"from": 774840,
				"to": 776120
			},
			"text": "であと馬が2機"
		},
		{
			"timestamps": {
				"from": "00:12:56,120",
				"to": "00:12:56,900"
			},
			"offsets": {
				"from": 776120,
				"to": 776900
			},
			"text": "9馬出し"
		},
		{
			"timestamps": {
				"from": "00:12:56,900",
				"to": "00:12:58,220"
			},
			"offsets": {
				"from": 776900,
				"to": 778220
			},
			"text": "9分の2"
		},
