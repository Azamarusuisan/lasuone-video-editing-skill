			"timestamps": {
				"from": "00:13:27,560",
				"to": "00:13:30,900"
			},
			"offsets": {
				"from": 807560,
				"to": 810900
			},
			"text": "ここだけかけます"
		},
		{
			"timestamps": {
				"from": "00:13:30,900",
				"to": "00:13:31,920"
			},
			"offsets": {
				"from": 810900,
				"to": 811920
			},
			"text": "6だけ"
		},
