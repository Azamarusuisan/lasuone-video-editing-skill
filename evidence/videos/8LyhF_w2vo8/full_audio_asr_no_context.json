			},
			"offsets": {
				"from": 144840,
				"to": 146840
			},
			"text": "バカラで1万5千ドルぐらい勝ってたんですよ"
		},
		{
			"timestamps": {
				"from": "00:02:26,840",
				"to": "00:02:30,540"
			},
			"offsets": {
				"from": 146840,
				"to": 150540
			},
			"text": "で調子に乗ってミリオネアメーカー馬6期出しとか言って"
		},
		{
			"timestamps": {
				"from": "00:02:30,540",
				"to": "00:02:32,500"
			},
			"offsets": {
				"from": 150540,
				"to": 152500
			},
			"text": "勝ってた分を投資しようとどうせなくなるから"
		},
		{
			"timestamps": {
				"from": "00:02:32,500",
				"to": "00:02:35,800"
			},
			"offsets": {
				"from": 152500,
				"to": 155800
			},
			"text": "自分で使える1万ドルとプラス1万5千ドルが勝つ"
		},
		{
			"timestamps": {
				"from": "00:02:35,800",
				"to": "00:02:38,780"
			},
			"offsets": {
				"from": 155800,
				"to": 158780
			},
			"text": "6人出したところで6千ドルだからだからまだ9千ドル勝ってたから"
		},
		{
			"timestamps": {
				"from": "00:02:38,780",
				"to": "00:02:40,720"
			},
			"offsets": {
				"from": 158780,
				"to": 160720
			},
			"text": "なんか分かんないけど昨日一人でやったら"
		},
		{
			"timestamps": {
				"from": "00:02:40,720",
				"to": "00:02:43,120"
			},
			"offsets": {
				"from": 160720,
				"to": 163120
			},
			"text": "俺の1万ドルも踏まえて全部なくなりました"
		},
		{
			"timestamps": {
				"from": "00:02:43,120",
				"to": "00:02:44,980"
			},
			"offsets": {
				"from": 163120,
				"to": 164980
			},
			"text": "えートータルマイナスになったってなるんです"
		},
