			},
			"offsets": {
				"from": 1050080,
				"to": 1055600
			},
			"text": "俺がそのエースアイフラッシュのドローで来るみたいなところが少し反省でもうちょっと小さく出てもいいかな"
		},
		{
			"timestamps": {
				"from": "00:17:35,600",
				"to": "00:17:38,020"
			},
			"offsets": {
				"from": 1055600,
				"to": 1058020
			},
			"text": "まあそんな感じでこの後もう一個出てきましょう"
		},
		{
			"timestamps": {
				"from": "00:17:38,020",
				"to": "00:17:40,160"
			},
			"offsets": {
				"from": 1058020,
				"to": 1060160
			},
			"text": "でも2連続インまでしたからね"
