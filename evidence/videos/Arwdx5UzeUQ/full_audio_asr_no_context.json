			},
			"offsets": {
				"from": 1035340,
				"to": 1039740
			},
			"text": "やっぱりいつかリスクを取ってやっていくってことに対してはやっていかないといけないかなっていう感じ"
		},
		{
			"timestamps": {
				"from": "00:17:19,740",
