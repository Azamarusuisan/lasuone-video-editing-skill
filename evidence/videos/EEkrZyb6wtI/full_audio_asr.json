		{
			"timestamps": {
				"from": "00:00:06,300",
				"to": "00:00:08,060"
			},
			"offsets": {
				"from": 6300,
				"to": 8060
			},
			"text": "今。"
		},
		{
			"timestamps": {
				"from": "00:00:08,060",
				"to": "00:00:10,080"
			},
			"offsets": {
				"from": 8060,
				"to": 10080
			},
			"text": "今、思いなくて。"
		},
		{
			"timestamps": {
				"from": "00:00:10,080",
				"to": "00:00:15,080"
			},
			"offsets": {
				"from": 10080,
				"to": 15080
			},
			"text": "しかし、全部生まればブラウンゾッツ。"
		},
		{
			"timestamps": {
				"from": "00:00:20,140",
				"to": "00:00:27,620"
			},
			"offsets": {
				"from": 20140,
				"to": 27620
			},
			"text": "じゃんじゃじゃーん、報酬袋を欲しいといったコメントの視聴者さんに今から発送してきます。"
		},
		{
			"timestamps": {
				"from": "00:00:27,620",
				"to": "00:00:33,380"
			},
			"offsets": {
				"from": 27620,
				"to": 33380
			},
			"text": "じゃあ、ここで視聴者プレゼント。"
		},
		{
			"timestamps": {
				"from": "00:00:33,380",
				"to": "00:00:37,100"
			},
			"offsets": {
				"from": 33380,
				"to": 37100
			},
			"text": "こちら、近代アート。迷えるもの。"
		},
		{
			"timestamps": {
				"from": "00:00:37,100",
				"to": "00:00:45,020"
			},
			"offsets": {
				"from": 37100,
				"to": 45020
			},
			"text": "これですね、これから作者が、今はまだこれから伸びてくるんだけど、これを結構持っていると、これから結構来る作者です。"
		},
		{
			"timestamps": {
				"from": "00:00:45,020",
				"to": "00:00:52,780"
			},
			"offsets": {
				"from": 45020,
				"to": 52780
			},
			"text": "で、作者が清水の方で、これから近代アートで来る。これは悩めるもの。"
		},
		{
			"timestamps": {
				"from": "00:00:52,780",
				"to": "00:00:56,540"
			},
			"offsets": {
				"from": 52780,
				"to": 56540
			},
			"text": "最近そういうのを売りつけるドラマ見ました?"
		},
		{
			"timestamps": {
				"from": "00:00:56,540",
				"to": "00:00:58,540"
			},
			"offsets": {
				"from": 56540,
				"to": 58540
			},
			"text": "こちら。"
		},
		{
			"timestamps": {
				"from": "00:00:58,540",
				"to": "00:01:01,300"
			},
			"offsets": {
				"from": 58540,
				"to": 61300
			},
			"text": "タイトル何だと思うから。"
		},
		{
			"timestamps": {
				"from": "00:01:01,300",
				"to": "00:01:04,300"
			},
			"offsets": {
				"from": 61300,
				"to": 64300
			},
			"text": "私外した団子。"
		},
		{
			"timestamps": {
				"from": "00:01:04,300",
				"to": "00:01:05,300"
			},
			"offsets": {
				"from": 64300,
				"to": 65300
			},
			"text": "違う。"
		},
		{
			"timestamps": {
				"from": "00:01:05,300",
				"to": "00:01:06,300"
			},
			"offsets": {
				"from": 65300,
				"to": 66300
			},
			"text": "ああ。"
		},
		{
			"timestamps": {
				"from": "00:01:06,300",
				"to": "00:01:10,740"
			},
			"offsets": {
				"from": 66300,
				"to": 70740
			},
			"text": "見る人によって、これ結構大事なのが、見る人によっていろんなものが見える。"
		},
		{
			"timestamps": {
				"from": "00:01:10,740",
				"to": "00:01:13,300"
			},
			"offsets": {
				"from": 70740,
				"to": 73300
			},
			"text": "っていうその、神羅万象。"
		},
		{
			"timestamps": {
				"from": "00:01:13,300",
				"to": "00:01:17,300"
			},
			"offsets": {
				"from": 73300,
				"to": 77300
			},
			"text": "見る人によっていろんなことが見える。100通りぐらい見えるんじゃないかな、これ。"
		},
		{
			"timestamps": {
				"from": "00:01:17,300",
				"to": "00:01:23,060"
			},
			"offsets": {
				"from": 77300,
				"to": 83060
			},
			"text": "っていう結構味が深い作品で、近代アートなんだ。"
		},
		{
			"timestamps": {
				"from": "00:01:23,060",
				"to": "00:01:26,060"
			},
			"offsets": {
				"from": 83060,
				"to": 86060
			},
			"text": "近代アート。ちょっとこれからすごい作ろうと思うんです。近代アート。"
