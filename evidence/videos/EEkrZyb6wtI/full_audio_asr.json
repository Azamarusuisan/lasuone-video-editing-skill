			"timestamps": {
				"from": "00:01:26,060",
				"to": "00:01:32,060"
			},
			"offsets": {
				"from": 86060,
				"to": 92060
			},
			"text": "で、ECサイトを作って、あとちょっとアパレルもやりたいなと思う。"
		},
		{
			"timestamps": {
				"from": "00:01:32,060",
