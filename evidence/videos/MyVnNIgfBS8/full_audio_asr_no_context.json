			"timestamps": {
				"from": "00:06:33,560",
				"to": "00:06:36,000"
			},
			"offsets": {
				"from": 393560,
				"to": 396000
			},
			"text": "もしよかったら特別条件でやらさせていただきますけど"
		},
		{
			"timestamps": {
				"from": "00:06:36,000",
				"to": "00:06:36,540"
			},
			"offsets": {
				"from": 396000,
				"to": 396540
			},
			"text": "いかがですか?"
		},
		{
			"timestamps": {
				"from": "00:06:36,740",
				"to": "00:06:40,160"
			},
			"offsets": {
				"from": 396740,
				"to": 400160
			},
			"text": "不動産の引っ越しだけじゃなくて、どんな商品にでも使えるのと、"
		},
		{
			"timestamps": {
				"from": "00:06:40,160",
				"to": "00:06:44,580"
			},
			"offsets": {
				"from": 400160,
				"to": 404580
			},
			"text": "とにかく毎日投稿を取って、買いそうな人に対してアウトバンド、"
		},
		{
			"timestamps": {
				"from": "00:06:44,720",
				"to": "00:06:50,580"
			},
			"offsets": {
				"from": 404720,
				"to": 410580
			},
			"text": "このSNSかけるアウトバンド、新しい営業スタイルができるというところがすごく強みになっていると。"
		},
		{
			"timestamps": {
				"from": "00:06:50,780",
				"to": "00:06:52,840"
			},
			"offsets": {
				"from": 410780,
				"to": 412840
			},
			"text": "これがオーダーメイドスーツ買いそうな人。"
		},
		{
			"timestamps": {
				"from": "00:06:52,960",
				"to": "00:06:57,240"
			},
			"offsets": {
				"from": 412960,
				"to": 417240
			},
			"text": "インスタでこういう投稿をしてます、みたいな人を見つけてきて、"
		},
		{
			"timestamps": {
				"from": "00:06:57,360",
				"to": "00:07:00,100"
			},
			"offsets": {
				"from": 417360,
				"to": 420100
			},
			"text": "その人に対してオーダーメイドスーツこういうのやってるんですけどどうですか?"
		},
		{
			"timestamps": {
				"from": "00:07:00,260",
				"to": "00:07:02,960"
			},
			"offsets": {
				"from": 420260,
				"to": 422960
			},
			"text": "ということを例えばインスタのDMで送るとか"
		},
		{
			"timestamps": {
				"from": "00:07:02,960",
				"to": "00:07:06,760"
			},
			"offsets": {
				"from": 422960,
				"to": 426760
			},
			"text": "そういうことができるような機能が実装されています"
		},
		{
			"timestamps": {
				"from": "00:07:06,760",
				"to": "00:07:10,840"
			},
			"offsets": {
				"from": 426760,
				"to": 430840
			},
			"text": "そこ以外にも追加でこういうことをしたいといったことに対しては"
		},
		{
			"timestamps": {
				"from": "00:07:10,840",
				"to": "00:07:12,540"
			},
			"offsets": {
				"from": 430840,
				"to": 432540
			},
			"text": "柔軟に対応させていただくのと"
		},
		{
			"timestamps": {
				"from": "00:07:12,540",
				"to": "00:07:14,660"
			},
			"offsets": {
				"from": 432540,
				"to": 434660
			},
			"text": "例えばこれ使い放題じゃなくてもいいから"
		},
		{
			"timestamps": {
				"from": "00:07:14,660",
				"to": "00:07:18,420"
			},
			"offsets": {
				"from": 434660,
				"to": 438420
			},
			"text": "インスタで毎月こういうリストだけ抜いてくれというパターンと"
		},
		{
			"timestamps": {
				"from": "00:07:18,420",
				"to": "00:07:21,460"
			},
			"offsets": {
				"from": 438420,
				"to": 441460
			},
			"text": "例えば都度ここのリストだけ我々得意だから"
		},
		{
			"timestamps": {
				"from": "00:07:21,460",
				"to": "00:07:24,760"
			},
			"offsets": {
				"from": 441460,
				"to": 444760
			},
			"text": "このリストだけ全部抜いてくれみたいなことに関しても"
		},
		{
			"timestamps": {
				"from": "00:07:24,760",
				"to": "00:07:28,000"
			},
			"offsets": {
				"from": 444760,
				"to": 448000
			},
			"text": "多分他社よりもかなり安くご提供ができますので"
		},
		{
			"timestamps": {
				"from": "00:07:28,000",
				"to": "00:07:31,040"
			},
			"offsets": {
				"from": 448000,
				"to": 451040
			},
			"text": "とにかくここのNAS1データ×SNS"
		},
		{
			"timestamps": {
				"from": "00:07:31,040",
				"to": "00:07:32,920"
			},
			"offsets": {
				"from": 451040,
				"to": 452920
			},
			"text": "この機能も実装されてますので"
		},
		{
			"timestamps": {
				"from": "00:07:32,920",
				"to": "00:07:34,200"
			},
			"offsets": {
				"from": 452920,
				"to": 454200
			},
			"text": "ぜひよろしくお願いします"
		},
		{
			"timestamps": {
				"from": "00:07:34,200",
				"to": "00:07:36,680"
			},
			"offsets": {
				"from": 454200,
				"to": 456680
			},
			"text": "改めて私が詳しくご説明いたします"
		},
		{
			"timestamps": {
				"from": "00:07:36,680",
				"to": "00:07:38,560"
			},
			"offsets": {
				"from": 456680,
				"to": 458560
			},
			"text": "営業成果を大きく左右するのは"
		},
		{
			"timestamps": {
				"from": "00:07:38,560",
				"to": "00:07:40,000"
			},
			"offsets": {
				"from": 458560,
				"to": 460000
			},
			"text": "営業力だけではありません"
		},
		{
			"timestamps": {
				"from": "00:07:40,000",
				"to": "00:07:43,560"
			},
			"offsets": {
				"from": 460000,
				"to": 463560
			},
			"text": "今成果を出す企業ほど質の高い営業リストを持っています"
		},
		{
			"timestamps": {
				"from": "00:07:43,560",
				"to": "00:07:46,120"
			},
			"offsets": {
				"from": 463560,
				"to": 466120
			},
			"text": "多くの企業では営業前のリスト作成に"
		},
		{
			"timestamps": {
				"from": "00:07:46,120",
				"to": "00:07:47,540"
			},
			"offsets": {
				"from": 466120,
				"to": 467540
			},
			"text": "大量の時間が消えています"
		},
		{
			"timestamps": {
				"from": "00:07:47,540",
				"to": "00:07:50,760"
			},
			"offsets": {
				"from": 467540,
				"to": 470760
			},
			"text": "しかし成果に直結するのは数ではなく質です"
		},
		{
			"timestamps": {
				"from": "00:07:50,760",
				"to": "00:07:53,960"
			},
			"offsets": {
				"from": 470760,
				"to": 473960
			},
			"text": "営業力以前に誰営業するかが間違っているケースは"
		},
		{
			"timestamps": {
				"from": "00:07:53,960",
				"to": "00:07:54,900"
			},
			"offsets": {
				"from": 473960,
				"to": 474900
			},
			"text": "少なくありません"
		},
		{
			"timestamps": {
				"from": "00:07:54,900",
				"to": "00:07:57,200"
			},
			"offsets": {
				"from": 474900,
				"to": 477200
			},
			"text": "だからこそリストの質が重要になります"
		},
		{
			"timestamps": {
				"from": "00:07:57,200",
				"to": "00:08:02,260"
			},
			"offsets": {
				"from": 477200,
				"to": 482260
			},
			"text": "ラストワンデータは営業リスト作成を自動化することで営業活動そのものを効率化します"
		},
		{
			"timestamps": {
				"from": "00:08:02,260",
				"to": "00:08:06,900"
			},
			"offsets": {
				"from": 482260,
				"to": 486900
			},
			"text": "不安なる営業リストではなく今使える営業リストを作れることが最大の違いです"
		},
		{
			"timestamps": {
				"from": "00:08:06,900",
				"to": "00:08:10,760"
			},
			"offsets": {
				"from": 486900,
				"to": 490760
			},
			"text": "専門知識がなくても欲しい条件のリストを直感的に抽出できます"
		},
		{
			"timestamps": {
				"from": "00:08:10,760",
				"to": "00:08:14,660"
			},
			"offsets": {
				"from": 490760,
				"to": 494660
			},
			"text": "営業メンバーは探す時間ではなく売る時間に集中できるようになります"
		},
		{
			"timestamps": {
				"from": "00:08:14,660",
				"to": "00:08:18,120"
			},
			"offsets": {
				"from": 494660,
				"to": 498120
			},
			"text": "業界ごとに本ニーズがある企業へアプローチできるのが強みです"
		},
		{
			"timestamps": {
				"from": "00:08:18,120",
				"to": "00:08:21,080"
			},
			"offsets": {
				"from": 498120,
				"to": 501080
			},
			"text": "営業人件費を増やす前に営業効率を改善する"
		},
		{
			"timestamps": {
				"from": "00:08:21,080",
				"to": "00:08:23,540"
			},
			"offsets": {
				"from": 501080,
				"to": 503540
			},
			"text": "その投資として多くの企業に選ばれています"
		},
		{
			"timestamps": {
				"from": "00:08:23,540",
				"to": "00:08:26,720"
			},
			"offsets": {
				"from": 503540,
				"to": 506720
			},
			"text": "営業成果を変えたいならまず変えるべきは営業先です"
		},
		{
			"timestamps": {
				"from": "00:08:27,200",
				"to": "00:08:29,560"
			},
			"offsets": {
				"from": 507200,
				"to": 509560
			},
			"text": "営業活動を次のステージへ導きます"
		},
		{
			"timestamps": {
				"from": "00:08:29,560",
				"to": "00:08:32,660"
			},
			"offsets": {
				"from": 509560,
				"to": 512660
			},
			"text": "こんな感じで説明は以上となりますが"
		},
		{
			"timestamps": {
				"from": "00:08:32,660",
				"to": "00:08:35,080"
			},
			"offsets": {
				"from": 512660,
				"to": 515080
			},
			"text": "こちらここからが一番大事であり"
		},
		{
			"timestamps": {
				"from": "00:08:35,080",
				"to": "00:08:36,620"
			},
			"offsets": {
				"from": 515080,
				"to": 516620
			},
			"text": "核となるところなんですけれども"
		},
		{
			"timestamps": {
				"from": "00:08:36,620",
				"to": "00:08:40,320"
			},
			"offsets": {
				"from": 516620,
				"to": 520320
			},
			"text": "何よりもこういう戦略を考えたりとか"
		},
		{
			"timestamps": {
				"from": "00:08:40,320",
				"to": "00:08:42,880"
			},
			"offsets": {
				"from": 520320,
				"to": 522880
			},
			"text": "営業をこういう風にやったらいいんじゃないですか"
		},
		{
			"timestamps": {
				"from": "00:08:42,880",
				"to": "00:08:47,240"
			},
			"offsets": {
				"from": 522880,
				"to": 527240
			},
			"text": "という僕のアドバイス付きっていうのが一番の強みで"
		},
		{
			"timestamps": {
				"from": "00:08:47,240",
				"to": "00:08:49,100"
			},
			"offsets": {
				"from": 527240,
				"to": 529100
			},
			"text": "それそのスクレーピングするとか"
		},
		{
			"timestamps": {
				"from": "00:08:49,100",
				"to": "00:08:50,480"
			},
			"offsets": {
				"from": 529100,
				"to": 530480
			},
			"text": "リストークとかっていうのは"
		},
		{
			"timestamps": {
				"from": "00:08:50,480",
				"to": "00:08:51,720"
			},
			"offsets": {
				"from": 530480,
				"to": 531720
			},
			"text": "他社さんもやってるだろうし"
		},
		{
			"timestamps": {
				"from": "00:08:51,720",
				"to": "00:08:53,060"
			},
			"offsets": {
				"from": 531720,
				"to": 533060
			},
			"text": "別にこれからも出てくる"
		},
		{
			"timestamps": {
				"from": "00:08:53,060",
				"to": "00:08:54,560"
			},
			"offsets": {
				"from": 533060,
				"to": 534560
			},
			"text": "ただ僕はノウハウがあるんで"
		},
		{
			"timestamps": {
				"from": "00:08:54,560",
				"to": "00:08:56,760"
			},
			"offsets": {
				"from": 534560,
				"to": 536760
			},
			"text": "いろんなものをエアで動いてくるんだけど"
		},
		{
			"timestamps": {
				"from": "00:08:56,760",
				"to": "00:09:02,440"
			},
			"offsets": {
				"from": 536760,
				"to": 542440
			},
			"text": "逆に言うとこの金額の中に俺の営業コンサルを月1回呼べつけるので"
		},
		{
			"timestamps": {
				"from": "00:09:02,440",
				"to": "00:09:04,340"
			},
			"offsets": {
				"from": 542440,
				"to": 544340
			},
			"text": "ここが一番強みです"
		},
		{
			"timestamps": {
				"from": "00:09:04,340",
				"to": "00:09:07,860"
			},
			"offsets": {
				"from": 544340,
				"to": 547860
			},
			"text": "なのでつまり何か営業をやりたいといったときに"
		},
		{
			"timestamps": {
				"from": "00:09:07,860",
				"to": "00:09:09,960"
			},
			"offsets": {
				"from": 547860,
				"to": 549960
			},
			"text": "ぶっちゃけこれはリストを作るんだけど"
		},
		{
			"timestamps": {
				"from": "00:09:09,960",
				"to": "00:09:12,240"
			},
			"offsets": {
				"from": 549960,
				"to": 552240
			},
			"text": "これともう1個今AIコールを"
		},
		{
			"timestamps": {
				"from": "00:09:12,240",
				"to": "00:09:16,080"
			},
			"offsets": {
				"from": 552240,
				"to": 556080
			},
			"text": "トップアポインターが電話をちょうどかけて"
		},
		{
			"timestamps": {
				"from": "00:09:16,080",
				"to": "00:09:21,000"
			},
			"offsets": {
				"from": 556080,
				"to": 561000
			},
			"text": "録音をして500パターンぐらいをAIで組み合わせて電話をするAIコール"
		},
		{
			"timestamps": {
				"from": "00:09:21,000",
				"to": "00:09:23,400"
			},
			"offsets": {
				"from": 561000,
				"to": 563400
			},
			"text": "こちらと合わせてそういうのも提案できたりとか"
		},
		{
			"timestamps": {
				"from": "00:09:23,400",
				"to": "00:09:25,900"
			},
			"offsets": {
				"from": 563400,
				"to": 565900
			},
			"text": "それ以外の相談も総括的にできるので"
		},
		{
			"timestamps": {
				"from": "00:09:25,900",
				"to": "00:09:28,800"
			},
			"offsets": {
				"from": 565900,
				"to": 568800
			},
			"text": "例えば営業でいいサービスを作ったら"
		},
		{
			"timestamps": {
				"from": "00:09:28,800",
				"to": "00:09:31,440"
			},
			"offsets": {
				"from": 568800,
				"to": 571440
			},
			"text": "一旦僕にお問い合わせをいただければ"
		},
		{
			"timestamps": {
				"from": "00:09:31,440",
				"to": "00:09:32,640"
			},
			"offsets": {
				"from": 571440,
				"to": 572640
			},
			"text": "何でも対応しますので"
		},
		{
			"timestamps": {
				"from": "00:09:32,640",
				"to": "00:09:33,400"
			},
			"offsets": {
				"from": 572640,
				"to": 573400
			},
			"text": "よろしくお願いします"
		},
		{
			"timestamps": {
				"from": "00:09:33,400",
				"to": "00:09:34,200"
			},
			"offsets": {
				"from": 573400,
				"to": 574200
			},
			"text": "よろしくお願いします"
		},
		{
			"timestamps": {
				"from": "00:09:34,200",
				"to": "00:09:36,060"
			},
			"offsets": {
				"from": 574200,
				"to": 576060
			},
			"text": "それでは稼ぎましょう"
		},
		{
			"timestamps": {
				"from": "00:09:36,060",
				"to": "00:09:38,220"
			},
			"offsets": {
				"from": 576060,
				"to": 578220
			},
			"text": "はい頑張ります"
		}
	]
}
