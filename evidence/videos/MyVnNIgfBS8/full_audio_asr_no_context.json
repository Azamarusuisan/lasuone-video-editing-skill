			"timestamps": {
				"from": "00:05:09,880",
				"to": "00:05:11,880"
			},
			"offsets": {
				"from": 309880,
				"to": 311880
			},
			"text": "大阪を選んでもらいます"
		},
		{
			"timestamps": {
				"from": "00:05:11,880",
				"to": "00:05:13,660"
			},
			"offsets": {
				"from": 311880,
				"to": 313660
			},
			"text": "どの業種を取りたいかというのを"
		},
		{
			"timestamps": {
				"from": "00:05:13,660",
				"to": "00:05:14,600"
			},
			"offsets": {
				"from": 313660,
				"to": 314600
			},
			"text": "こちらの方で選んでもらって"
		},
		{
			"timestamps": {
				"from": "00:05:14,600",
				"to": "00:05:16,380"
			},
			"offsets": {
				"from": 314600,
				"to": 316380
			},
			"text": "このキーワードはキーワードの方で取れます"
		},
		{
			"timestamps": {
				"from": "00:05:16,380",
				"to": "00:05:18,760"
			},
			"offsets": {
				"from": 316380,
				"to": 318760
			},
			"text": "何件取りたいのかというところなんだけど"
