			"timestamps": {
				"from": "00:04:42,640",
				"to": "00:04:45,300"
			},
			"offsets": {
				"from": 282640,
				"to": 285300
			},
			"text": "最新機能も入れておりまして"
		},
		{
			"timestamps": {
