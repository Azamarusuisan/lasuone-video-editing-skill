				"to": "00:04:40,040"
			},
			"offsets": {
				"from": 277260,
				"to": 280040
			},
			"text": "このシステムだけ欲しいとかも全面的に受け付けます"
		},
		{
			"timestamps": {
				"from": "00:04:40,040",
				"to": "00:04:42,640"
			},
			"offsets": {
				"from": 280040,
				"to": 282640
			},
			"text": "20万払えばとにかく全部使えるよということで"
		},
