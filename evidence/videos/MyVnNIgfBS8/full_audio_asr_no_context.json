				"to": "00:05:02,180"
			},
			"offsets": {
				"from": 299780,
				"to": 302180
			},
			"text": "ここから例えばInstagramから"
		},
		{
			"timestamps": {
				"from": "00:05:02,180",
				"to": "00:05:04,860"
			},
			"offsets": {
				"from": 302180,
				"to": 304860
			},
			"text": "例えば大阪の建築業を取りたいと"
		},
		{
