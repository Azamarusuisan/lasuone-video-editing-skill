			"timestamps": {
				"from": "00:04:51,820",
				"to": "00:04:59,780"
			},
			"offsets": {
				"from": 291820,
				"to": 299780
			},
			"text": "X、Facebook、Ravit、TikTok、YouTube、LinkedIn、Instagramが取れるようになってきます"
		},
		{
			"timestamps": {
