				"to": "00:03:56,600"
			},
			"offsets": {
				"from": 234600,
				"to": 236600
			},
			"text": "それが体勢ですか?"
		},
		{
			"timestamps": {
				"from": "00:03:56,600",
				"to": "00:04:08,600"
			},
			"offsets": {
				"from": 236600,
				"to": 248600
			},
			"text": "そうだね。今年は本当にもう少し枠を広げて、50人とか100人くらいの輪にして、そこの中でいろんな、俺が持っているAIの事業とかを掛け合わせて事業が生まれてくるんだろうし、もっとできることが増える。"
		},
		{
			"timestamps": {
				"from": "00:04:08,600",
				"to": "00:04:10,940"
			},
			"offsets": {
				"from": 248600,
				"to": 250940
			},
			"text": "増える"
		},
		{
			"timestamps": {
				"from": "00:04:12,600",
				"to": "00:04:18,940"
			},
			"offsets": {
				"from": 252600,
				"to": 258940
			},
			"text": "やっぱそのポーカーをやる会場にはカジノって言う 人を狂わすゲーム"
		},
		{
			"timestamps": {
				"from": "00:04:18,940",
				"to": "00:04:25,480"
			},
			"offsets": {
				"from": 258940,
				"to": 265480
			},
			"text": "バカがやるゲームがから まあなんだかんだ供養曲折あって"
		},
		{
			"timestamps": {
				"from": "00:04:25,480",
				"to": "00:04:29,840"
			},
			"offsets": {
				"from": 265480,
				"to": 269840
			},
			"text": "うよ曲折あって 20億円くらいだったお金が"
		},
		{
			"timestamps": {
