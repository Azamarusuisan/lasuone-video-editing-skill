				"to": "00:00:42,620"
			},
			"offsets": {
				"from": 40040,
				"to": 42620
			},
			"text": "すごい盛り上がれるシーンを作って"
		},
		{
			"timestamps": {
				"from": "00:00:42,620",
				"to": "00:00:44,420"
			},
			"offsets": {
				"from": 42620,
				"to": 44420
			},
			"text": "結果はちょっと大したことなかったんだけど"
		},
		{
			"timestamps": {
