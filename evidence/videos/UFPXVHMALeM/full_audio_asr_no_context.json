		{
			"timestamps": {
				"from": "00:03:14,960",
				"to": "00:03:19,700"
			},
			"offsets": {
				"from": 194960,
				"to": 199700
			},
			"text": "みんなのためにしますよ、100パーみんなのために、ご自身の夢とか"
