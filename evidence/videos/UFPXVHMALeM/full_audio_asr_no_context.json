				"to": "00:01:57,880"
			},
			"offsets": {
				"from": 110240,
				"to": 117880
			},
			"text": "フザケルと負けるって言うのは何なのか分かってちゃうんだよ"
		},
		{
			"timestamps": {
				"from": "00:01:57,880",
				"to": "00:02:17,040"
			},
			"offsets": {
				"from": 117880,
				"to": 137040
			},
			"text": "一旦今回のWSOPで一旦ポーカーは最後にしようかなと"
		},
		{
			"timestamps": {
				"from": "00:02:17,040",
				"to": "00:02:24,240"
			},
			"offsets": {
				"from": 137040,
				"to": 144240
			},
			"text": "出場箱落としは最後いくなるほど行きたい早く行きたいで早く行きたいんだけど 金が集まらないといけないんですよ"
		},
		{
			"timestamps": {
				"from": "00:02:24,240",
				"to": "00:02:31,060"
			},
			"offsets": {
				"from": 144240,
				"to": 151060
			},
			"text": "集まったらもうろ過追い出しから行きたいですよ 今回はちょっとステーキングって言うともう面倒くさいので広告です"
		},
		{
			"timestamps": {
				"from": "00:02:31,060",
				"to": "00:02:36,260"
			},
			"offsets": {
				"from": 151060,
				"to": 156260
			},
			"text": "コモンです ai の研修なんでもいいです なので本当にシンプルに応援です"
