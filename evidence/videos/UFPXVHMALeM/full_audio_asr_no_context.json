				"to": "00:03:23,600"
			},
			"offsets": {
				"from": 199700,
				"to": 203600
			},
			"text": "自分の夢も98パーくらいになって"
		},
		{
			"timestamps": {
				"from": "00:03:23,600",
				"to": "00:03:26,980"
			},
			"offsets": {
				"from": 203600,
				"to": 206980
			},
			"text": "ほとんど、2パーはみなさん"
