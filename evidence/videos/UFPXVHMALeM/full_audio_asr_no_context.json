				"to": "00:01:16,840"
			},
			"offsets": {
				"from": 72960,
				"to": 76840
			},
			"text": "楽しいんでいただけた時もあったのかなとは思っているので"
		},
		{
			"timestamps": {
				"from": "00:01:16,840",
				"to": "00:01:17,520"
			},
			"offsets": {
				"from": 76840,
				"to": 77520
			},
			"text": "それは良かった"
		},
		{
			"timestamps": {
				"from": "00:01:17,520",
				"to": "00:01:21,240"
			},
			"offsets": {
				"from": 77520,
				"to": 81240
			},
			"text": "やっぱり他の色々海外も行かれてると思うんですけど"
		},
		{
			"timestamps": {
				"from": "00:01:21,240",
				"to": "00:01:24,740"
			},
			"offsets": {
				"from": 81240,
				"to": 84740
			},
			"text": "なんかそこと比べてもなんかちゃんと違いましたか鳥とんは"
		},
		{
			"timestamps": {
				"from": "00:01:24,740",
				"to": "00:01:27,080"
			},
			"offsets": {
				"from": 84740,
				"to": 87080
			},
			"text": "まあやっぱ違うんじゃないですかね"
		},
		{
			"timestamps": {
				"from": "00:01:27,080",
				"to": "00:01:31,260"
			},
			"offsets": {
				"from": 87080,
				"to": 91260
			},
			"text": "まあ要は宅の中で美味しいみたいなお茶が一人目ねって言うんだけどね"
		},
		{
			"timestamps": {
				"from": "00:01:31,260",
				"to": "00:01:31,920"
			},
			"offsets": {
				"from": 91260,
				"to": 91920
			},
			"text": "そうですね"
		},
		{
			"timestamps": {
