				"to": "00:03:33,700"
			},
			"offsets": {
				"from": 210900,
				"to": 213700
			},
			"text": "その人に出してもらうっていうのは、まさの全球取り手なのかな"
		},
		{
			"timestamps": {
				"from": "00:03:33,700",
				"to": "00:03:34,700"
			},
			"offsets": {
				"from": 213700,
				"to": 214700
			},
			"text": "あ、そうだ"
		},
		{
			"timestamps": {
				"from": "00:03:34,700",
				"to": "00:03:37,840"
			},
			"offsets": {
				"from": 214700,
				"to": 217840
			},
			"text": "3,000万集まってみたいな感じですけど、あれはやっぱり良かったんですよね"
