		{
			"timestamps": {
				"from": "00:03:37,840",
				"to": "00:03:39,600"
			},
			"offsets": {
				"from": 217840,
				"to": 219600
			},
			"text": "あれは良かった、めちゃくちゃ良くて"
		},
		{
			"timestamps": {
				"from": "00:03:39,600",
				"to": "00:03:54,600"
			},
			"offsets": {
				"from": 219600,
				"to": 234600
			},
			"text": "2000万だけど、集まった人数って30人くらいいて、25人くらいいて、その25人が全部一体になって、仕事も生まれて、仲良くなれてっていうのがすごい良かったかなって。"
		},
