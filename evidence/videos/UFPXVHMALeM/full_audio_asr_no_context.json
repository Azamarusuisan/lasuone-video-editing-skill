				"to": "00:01:03,660"
			},
			"offsets": {
				"from": 61160,
				"to": 63660
			},
			"text": "想像通り手が分かっただけだって"
		},
		{
			"timestamps": {
				"from": "00:01:03,660",
				"to": "00:01:06,840"
			},
			"offsets": {
				"from": 63660,
				"to": 66840
			},
			"text": "行ってみて実際行こうだったとかはないんですけど"
		},
		{
			"timestamps": {
				"from": "00:01:06,840",
				"to": "00:01:09,920"
			},
			"offsets": {
				"from": 66840,
				"to": 69920
			},
			"text": "今回いろんな人に応援していただいて"
		},
		{
			"timestamps": {
				"from": "00:01:09,920",
				"to": "00:01:12,960"
			},
			"offsets": {
				"from": 69920,
				"to": 72960
			},
			"text": "ちょっと結果は良くなかった時に出さなかったです"
		},
		{
			"timestamps": {
