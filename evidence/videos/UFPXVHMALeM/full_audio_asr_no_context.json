		{
			"timestamps": {
				"from": "00:03:11,200",
				"to": "00:03:14,960"
			},
			"offsets": {
				"from": 191200,
				"to": 194960
			},
			"text": "一旦のフォーカーの区切りをつけたいなと思った"
