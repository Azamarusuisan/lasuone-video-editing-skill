				"to": "00:04:34,320"
			},
			"offsets": {
				"from": 269840,
				"to": 274320
			},
			"text": "ほぼゼロだったんですよ どうやって制限されるんですか"
		},
		{
			"timestamps": {
				"from": "00:04:34,320",
				"to": "00:04:37,160"
			},
			"offsets": {
				"from": 274320,
				"to": 277160
			},
			"text": "草とか食べて"
		},
		{
			"timestamps": {
				"from": "00:04:37,220",
				"to": "00:04:43,200"
			},
			"offsets": {
				"from": 277220,
				"to": 283200
			},
			"text": "っていうのは冗談でまあ今そのありがたいことに顧問先とか まあある程度"
		},
		{
			"timestamps": {
				"from": "00:04:43,200",
				"to": "00:04:52,260"
