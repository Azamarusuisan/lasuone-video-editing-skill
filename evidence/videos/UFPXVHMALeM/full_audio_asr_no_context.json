		{
			"timestamps": {
				"from": "00:00:51,960",
				"to": "00:00:52,540"
			},
			"offsets": {
				"from": 51960,
				"to": 52540
			},
			"text": "トリトンって"
		},
		{
			"timestamps": {
				"from": "00:00:52,540",
				"to": "00:00:53,980"
			},
			"offsets": {
				"from": 52540,
				"to": 53980
			},
			"text": "どうですか"
