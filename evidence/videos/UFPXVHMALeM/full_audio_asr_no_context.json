				"to": "00:01:33,960"
			},
			"offsets": {
				"from": 91920,
				"to": 93960
			},
			"text": "だから俺たちが美味しいって思われてるだけだから"
		},
		{
			"timestamps": {
				"from": "00:01:33,960",
				"to": "00:01:38,760"
			},
			"offsets": {
				"from": 93960,
				"to": 98760
			},
			"text": "一瞬そのお二人が同宅されたりするような時もあったかと思うんですけど"
		},
		{
			"timestamps": {
				"from": "00:01:38,760",
				"to": "00:01:41,460"
			},
			"offsets": {
				"from": 98760,
				"to": 101460
			},
			"text": "なんかその感じとかどうでしたか"
		},
		{
			"timestamps": {
				"from": "00:01:41,460",
				"to": "00:01:43,760"
			},
			"offsets": {
				"from": 101460,
				"to": 103760
			},
			"text": "なんか二人でなんかわきあいあいってやってたのか"
