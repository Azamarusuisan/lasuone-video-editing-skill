				"to": 489420
			},
			"text": "現地からのお礼動画というか"
		},
		{
			"timestamps": {
				"from": "00:08:09,420",
				"to": "00:08:12,220"
			},
			"offsets": {
				"from": 489420,
				"to": 492220
			},
			"text": "これは現地のレポーティングですね"
		},
		{
			"timestamps": {
				"from": "00:08:12,220",
				"to": "00:08:14,220"
			},
			"offsets": {
				"from": 492220,
				"to": 494220
			},
			"text": "これグループチャットでやります"
		},
		{
			"timestamps": {
				"from": "00:08:14,220",
				"to": "00:08:18,520"
			},
			"offsets": {
				"from": 494220,
				"to": 498520
			},
			"text": "ギャン玉AI魂で皆様の商品を宣伝します"
		},
		{
			"timestamps": {
				"from": "00:08:18,520",
				"to": "00:08:21,500"
			},
			"offsets": {
				"from": 498520,
				"to": 501500
			},
			"text": "ロゴや写面を面白くやります"
		},
		{
			"timestamps": {
				"from": "00:08:21,500",
				"to": "00:08:22,920"
			},
			"offsets": {
				"from": 501500,
				"to": 502920
			},
			"text": "ポイントはここです"
		},
		{
			"timestamps": {
				"from": "00:08:22,920",
				"to": "00:08:24,160"
			},
			"offsets": {
				"from": 502920,
				"to": 504160
			},
			"text": "動くんだねこれ"
		},
		{
			"timestamps": {
				"from": "00:08:24,160",
				"to": "00:08:27,460"
			},
			"offsets": {
				"from": 504160,
				"to": 507460
			},
			"text": "鉄から出た場合何かが起きる"
		},
		{
			"timestamps": {
				"from": "00:08:27,460",
				"to": "00:08:29,140"
			},
			"offsets": {
				"from": 507460,
				"to": 509140
			},
			"text": "そのまま気持ちが爆発するタイプ"
		},
		{
			"timestamps": {
				"from": "00:08:29,140",
				"to": "00:08:35,460"
			},
			"offsets": {
				"from": 509140,
				"to": 515460
			},
			"text": "優勝や高成績で何かが起こる場は誰も予想できません 当て以外のリターンがあるかも"
		},
		{
			"timestamps": {
				"from": "00:08:35,460",
				"to": "00:08:41,500"
			},
			"offsets": {
				"from": 515460,
				"to": 521500
			},
			"text": "100万出したらリターンは何かおかしい 広告のリターンは当然出させていただきますが"
		},
		{
			"timestamps": {
				"from": "00:08:41,500",
				"to": "00:08:49,320"
			},
			"offsets": {
				"from": 521500,
				"to": 529320
			},
			"text": "何かが起きるかもそこはお問い合わせいただいて ご詳細をいただければと思います"
		},
		{
			"timestamps": {
				"from": "00:08:49,320",
				"to": "00:08:55,380"
			},
			"offsets": {
				"from": 529320,
				"to": 535380
			},
			"text": "なぜシャツアのスポンサーになるべきか まあ元上場企業もっとなんとかとかあんまり良くない"
		},
		{
			"timestamps": {
				"from": "00:08:55,380",
				"to": "00:09:02,660"
			},
			"offsets": {
				"from": 535380,
				"to": 542660
			},
			"text": "今が大事だ。基本的には26歳から立ち上げた会社を上場させたっていうのはあるかもしれないけど、"
		},
		{
			"timestamps": {
				"from": "00:09:02,660",
				"to": "00:09:10,420"
			},
			"offsets": {
				"from": 542660,
				"to": 550420
			},
			"text": "どちらかというとやっぱり光通信で18歳から叩き上げられた営業力と人脈をしっかりやっていくというところと、"
		},
