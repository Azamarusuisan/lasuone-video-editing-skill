				"to": "00:02:56,640"
			},
			"offsets": {
				"from": 172280,
				"to": 176640
			},
			"text": "今回はソロプレイヤーとして行くんですね。一応トリトンマスの中、ツシーナさんと。"
		},
		{
			"timestamps": {
				"from": "00:02:56,640",
				"to": "00:03:01,980"
			},
			"offsets": {
				"from": 176640,
				"to": 181980
			},
			"text": "そうね。今回はソロラス。"
		},
		{
			"timestamps": {
