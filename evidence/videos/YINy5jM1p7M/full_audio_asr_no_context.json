			},
			"offsets": {
				"from": 234400,
				"to": 235160
			},
			"text": "面白いよね"
		},
		{
			"timestamps": {
				"from": "00:03:55,160",
				"to": "00:03:55,760"
			},
			"offsets": {
				"from": 235160,
				"to": 235760
			},
			"text": "面白いっす"
		},
		{
			"timestamps": {
				"from": "00:03:55,760",
				"to": "00:03:56,320"
			},
			"offsets": {
				"from": 235760,
				"to": 236320
			},
			"text": "面白いよね"
		},
		{
			"timestamps": {
				"from": "00:03:56,320",
				"to": "00:03:59,420"
			},
			"offsets": {
				"from": 236320,
				"to": 239420
			},
			"text": "で、バカラっていうのは人生の本質が詰まってる"
		},
		{
			"timestamps": {
				"from": "00:03:59,420",
				"to": "00:04:00,200"
			},
			"offsets": {
				"from": 239420,
				"to": 240200
			},
			"text": "まあそうですね"
		},
		{
			"timestamps": {
				"from": "00:04:00,200",
				"to": "00:04:02,760"
			},
			"offsets": {
				"from": 240200,
				"to": 242760
			},
			"text": "その本質を僕は教えてあげることができるので"
		},
		{
			"timestamps": {
				"from": "00:04:02,760",
				"to": "00:04:05,340"
			},
			"offsets": {
				"from": 242760,
				"to": 245340
			},
			"text": "バカラ顧問もぜひ"
		},
		{
			"timestamps": {
				"from": "00:04:05,340",
				"to": "00:04:09,180"
			},
			"offsets": {
				"from": 245340,
				"to": 249180
			},
			"text": "え、なにここでプレイヤーだよって当たったらなんか控除されるの?"
		},
		{
			"timestamps": {
				"from": "00:04:09,180",
				"to": "00:04:10,360"
			},
			"offsets": {
				"from": 249180,
				"to": 250360
			},
			"text": "いや、そうじゃなくてですね"
		},
		{
			"timestamps": {
				"from": "00:04:10,360",
				"to": "00:04:18,560"
			},
			"offsets": {
				"from": 250360,
				"to": 258560
			},
			"text": "ブーブーどうやったらバカらを楽しめるか絞り方 絞り方もそうですしその負けたときの心構えなんでそれ"
		},
		{
			"timestamps": {
				"from": "00:04:18,560",
				"to": "00:04:26,020"
			},
			"offsets": {
				"from": 258560,
				"to": 266020
			},
			"text": "またその一体感 まあねみんなで肩を込んで園充でだと結構検証したのがトランプにバカ野郎"
		},
		{
			"timestamps": {
				"from": "00:04:26,020",
				"to": "00:04:34,400"
			},
			"offsets": {
				"from": 266020,
				"to": 274400
			},
			"text": "5回行った時の勝敗とありがとうって5回行った時の勝敗がなんと2%するとねえ じゃあいばいか"
		},
		{
			"timestamps": {
				"from": "00:04:34,400",
				"to": "00:04:40,240"
			},
			"offsets": {
				"from": 274400,
				"to": 280240
			},
			"text": "そっからやってるのまずピクチャーが来たら 土台を土台しっかり"
		},
		{
			"timestamps": {
				"from": "00:04:40,240",
				"to": "00:04:47,860"
			},
			"offsets": {
				"from": 280240,
				"to": 287860
			},
			"text": "ピクチャーたら癒さないですよなんだけどそのピクチャーと足がついたら組み合わせが いいわけですよ"
		},
		{
			"timestamps": {
				"from": "00:04:47,860",
				"to": "00:04:55,900"
			},
			"offsets": {
				"from": 287860,
				"to": 295900
			},
			"text": "ありがとう足もまず放射でついたありがとう全部に対してのポイントにありがとう 2%勝率が上がることが"
		},
		{
			"timestamps": {
				"from": "00:04:55,900",
				"to": "00:05:05,560"
			},
			"offsets": {
				"from": 295900,
				"to": 305560
			},
			"text": "どうなんだ一般で買いないパーでないですかだってローリング額考えたねプラススプーン これを本当にフィリピンで自己の実証したら"
		},
		{
			"timestamps": {
				"from": "00:05:05,560",
				"to": "00:05:08,900"
			},
			"offsets": {
				"from": 305560,
				"to": 308900
			},
			"text": "初めて買ったんですよ それ"
		},
		{
			"timestamps": {
				"from": "00:05:08,900",
				"to": "00:05:18,720"
			},
			"offsets": {
				"from": 308900,
				"to": 318720
			},
			"text": "なんでは僕がえっとこの先のと一緒にバカラーに行って本当にトランプリンありがとう ということによってプラスだったりなんかならなかったり"
		},
		{
			"timestamps": {
				"from": "00:05:18,720",
				"to": "00:05:25,000"
			},
			"offsets": {
				"from": 318720,
				"to": 325000
			},
			"text": "以上ですがギャンブルしているところが楽しく晴らせるんですけど仕事に何か 真面目に行っちゃうんで一応"
		},
		{
			"timestamps": {
				"from": "00:05:25,000",
				"to": "00:05:33,900"
			},
			"offsets": {
				"from": 325000,
				"to": 333900
			},
			"text": "ai とか営業の関係でラストンさんの力を借りたいというとも年間100万円 プランですけれどもバカラのカードにありがとうと言ってもらいたい方"
		},
		{
			"timestamps": {
				"from": "00:05:33,900",
				"to": "00:05:40,760"
			},
			"offsets": {
				"from": 333900,
				"to": 340760
			},
			"text": "とぜひ100万円100万円ということですねそうですも一緒に今後来てくれるんですよ 聞いたり"
		},
		{
			"timestamps": {
				"from": "00:05:40,760",
				"to": "00:05:42,880"
			},
			"offsets": {
				"from": 340760,
				"to": 342880
			},
			"text": "むしろ吸い出てくれと"
		},
		{
			"timestamps": {
				"from": "00:05:42,880",
				"to": "00:05:44,640"
			},
			"offsets": {
				"from": 342880,
				"to": 344640
			},
			"text": "まあいいよねー、楽しいよねー"
		},
		{
			"timestamps": {
				"from": "00:05:44,640",
				"to": "00:05:45,300"
			},
			"offsets": {
				"from": 344640,
				"to": 345300
			},
			"text": "若い"
		},
		{
			"timestamps": {
				"from": "00:05:45,300",
				"to": "00:05:46,300"
			},
			"offsets": {
				"from": 345300,
				"to": 346300
			},
			"text": "っていう形でございますね"
		},
		{
			"timestamps": {
				"from": "00:05:46,300",
				"to": "00:05:48,000"
			},
			"offsets": {
				"from": 346300,
				"to": 348000
			},
			"text": "あゆさん、本当にありがとうございます"
		},
		{
			"timestamps": {
				"from": "00:05:48,000",
				"to": "00:05:49,440"
			},
			"offsets": {
				"from": 348000,
				"to": 349440
			},
			"text": "マジ謎でいいですね"
		},
		{
			"timestamps": {
				"from": "00:05:49,440",
				"to": "00:05:51,640"
			},
			"offsets": {
				"from": 349440,
				"to": 351640
			},
			"text": "意外と本体よりも"
		},
		{
			"timestamps": {
				"from": "00:05:51,640",
				"to": "00:05:54,320"
			},
			"offsets": {
				"from": 351640,
				"to": 354320
			},
			"text": "韓国バカラ顧問が10件とか来るかもよ"
		},
		{
			"timestamps": {
				"from": "00:05:54,320",
				"to": "00:05:55,760"
			},
			"offsets": {
				"from": 354320,
				"to": 355760
			},
			"text": "確かに、確かに"
		},
		{
			"timestamps": {
				"from": "00:05:55,760",
				"to": "00:05:57,080"
			},
			"offsets": {
				"from": 355760,
				"to": 357080
			},
			"text": "チャンネル特性上"
		},
		{
			"timestamps": {
				"from": "00:05:57,080",
				"to": "00:06:00,160"
			},
			"offsets": {
				"from": 357080,
				"to": 360160
			},
			"text": "「え、ラサンサの韓国系のうそい白魔だったら全然いいよ」"
		},
		{
			"timestamps": {
				"from": "00:06:00,160",
				"to": "00:06:02,760"
			},
			"offsets": {
				"from": 360160,
				"to": 362760
			},
			"text": "「女、ワンベットだろ、いいよ」って言ったよ"
		},
		{
			"timestamps": {
				"from": "00:06:02,760",
				"to": "00:06:05,060"
			},
			"offsets": {
				"from": 362760,
				"to": 365060
			},
			"text": "「しかも増えそうじゃん、楽しそうじゃん」って人とか来るんじゃない?"
		},
		{
			"timestamps": {
				"from": "00:06:05,060",
				"to": "00:06:06,040"
			},
			"offsets": {
				"from": 365060,
				"to": 366040
			},
			"text": "そう、そうっすね"
		},
		{
			"timestamps": {
				"from": "00:06:06,040",
				"to": "00:06:07,840"
			},
			"offsets": {
				"from": 366040,
				"to": 367840
			},
			"text": "ちなみに俺、クライアントと絞ってるとき"
		},
		{
			"timestamps": {
				"from": "00:06:07,840",
				"to": "00:06:09,840"
			},
			"offsets": {
				"from": 367840,
				"to": 369840
			},
			"text": "クライアントさん、今んとこ勝率100%"
		},
		{
			"timestamps": {
				"from": "00:06:09,840",
				"to": "00:06:17,200"
			},
			"offsets": {
				"from": 369840,
				"to": 377200
			},
			"text": "a じゃあ一緒に行こうは一緒にもと入るとだろ大丈夫 燃焼記録止まっちゃうよそれ"
		},
		{
			"timestamps": {
				"from": "00:06:17,200",
				"to": "00:06:26,880"
			},
			"offsets": {
				"from": 377200,
				"to": 386880
			},
			"text": "えええさすがに大丈夫だったほんとかよ量子力学的に人のためを思ってやるっていうのは 要するそういう結果プラスになるんですよ"
		},
		{
			"timestamps": {
				"from": "00:06:26,880",
				"to": "00:06:37,840"
			},
			"offsets": {
				"from": 386880,
				"to": 397840
			},
			"text": "ちょっとだって水もありがとうって言ったら水の粒子のケースからじゃあいっそのこと わかんないけどこの動画で申し込んだ人一緒に韓国にポーツは組んじゃったらいいんじゃ"
		},
		{
			"timestamps": {
				"from": "00:06:37,840",
				"to": "00:06:44,600"
			},
			"offsets": {
				"from": 397840,
				"to": 404600
			},
			"text": "行きたいをナスワン林と行くラスワン 林といく韓国韓国カジノツアー"
		},
		{
			"timestamps": {
				"from": "00:06:44,600",
				"to": "00:06:49,900"
			},
			"offsets": {
				"from": 404600,
				"to": 409900
			},
			"text": "カジノツアーたい100万円振り込んで くれた方はあの日程合わせましょう"
		},
		{
			"timestamps": {
				"from": "00:06:49,900",
				"to": "00:06:53,860"
			},
			"offsets": {
				"from": 409900,
				"to": 413860
			},
			"text": "すごい土台しっかりプランね土台しっかり プランまあ6月ぐらい"
		},
		{
			"timestamps": {
				"from": "00:06:53,860",
				"to": "00:06:59,540"
			},
			"offsets": {
				"from": 413860,
				"to": 419540
			},
			"text": "ながら日程度払っても6月ぐらい6月ぐらい みんなで行くまあ結局払って絶対勝つ"
		},
		{
			"timestamps": {
				"from": "00:06:59,540",
				"to": "00:07:01,700"
			},
			"offsets": {
				"from": 419540,
				"to": 421700
			},
			"text": "んだよ なんか二毛足で行く"
		},
		{
			"timestamps": {
				"from": "00:07:01,700",
				"to": "00:07:06,620"
			},
			"offsets": {
				"from": 421700,
				"to": 426620
			},
			"text": "じゃあ僕も払っておかないと思う 保険で払っておくよ100万"
		},
		{
			"timestamps": {
				"from": "00:07:06,620",
				"to": "00:07:12,540"
			},
			"offsets": {
				"from": 426620,
				"to": 432540
			},
			"text": "というわけでまともに普通に仕事を 手伝ってもらいたい人営業と ai が得意で"
		},
		{
			"timestamps": {
				"from": "00:07:12,540",
				"to": "00:07:16,720"
			},
			"offsets": {
				"from": 432540,
				"to": 436720
			},
			"text": "ございますね上場経験ありますコメントね ご存知だと思いますけどねラスワンさんと"
		},
		{
			"timestamps": {
				"from": "00:07:16,720",
				"to": "00:07:21,180"
			},
			"offsets": {
				"from": 436720,
				"to": 441180
			},
			"text": "一緒にバカラを行った場合勝率がなんと 100%です"
		},
		{
			"timestamps": {
				"from": "00:07:21,180",
				"to": "00:07:25,320"
			},
			"offsets": {
				"from": 441180,
				"to": 445320
			},
			"text": "てことはでもラスワンさん今までギャンブルの通算成績が?"
		},
		{
			"timestamps": {
				"from": "00:07:25,540",
				"to": "00:07:27,000"
			},
			"offsets": {
				"from": 445540,
				"to": 447000
			},
			"text": "まあ20万円安いですけど"
		},
		{
			"timestamps": {
				"from": "00:07:27,000",
				"to": "00:07:28,000"
			},
			"offsets": {
				"from": 447000,
				"to": 448000
			},
			"text": "はいありがとうございます"
		},
		{
			"timestamps": {
				"from": "00:07:28,000",
				"to": "00:07:28,340"
			},
			"offsets": {
				"from": 448000,
				"to": 448340
			},
			"text": "ありがとうございます"
		},
		{
			"timestamps": {
				"from": "00:07:28,340",
				"to": "00:07:30,180"
			},
			"offsets": {
				"from": 448340,
				"to": 450180
			},
			"text": "おかしいなぁ"
		},
		{
			"timestamps": {
				"from": "00:07:30,180",
				"to": "00:07:31,080"
			},
			"offsets": {
				"from": 450180,
				"to": 451080
			},
			"text": "人のためだろうね"
		},
		{
			"timestamps": {
				"from": "00:07:31,080",
				"to": "00:07:31,580"
			},
			"offsets": {
				"from": 451080,
				"to": 451580
			},
			"text": "人のためだろう"
		},
		{
			"timestamps": {
				"from": "00:07:31,580",
				"to": "00:07:32,320"
			},
			"offsets": {
				"from": 451580,
				"to": 452320
			},
			"text": "いけるんですよね"
		},
		{
			"timestamps": {
				"from": "00:07:32,320",
				"to": "00:07:38,820"
			},
			"offsets": {
				"from": 452320,
				"to": 458820
			},
			"text": "この動画で何人心の優しい方、ゴール広い方が申し込んでくれて国税にお支払いできるか"
		},
		{
			"timestamps": {
				"from": "00:07:38,820",
				"to": "00:07:40,060"
			},
			"offsets": {
				"from": 458820,
				"to": 460060
			},
			"text": "皆さんの力にかかってます"
		},
		{
			"timestamps": {
				"from": "00:07:40,060",
				"to": "00:07:41,260"
			},
			"offsets": {
				"from": 460060,
				"to": 461260
			},
			"text": "どうぞよろしくお願いします"
		},
		{
			"timestamps": {
				"from": "00:07:41,260",
				"to": "00:07:41,940"
			},
			"offsets": {
				"from": 461260,
				"to": 461940
			},
			"text": "よろしくお願いします"
		},
		{
			"timestamps": {
				"from": "00:07:41,940",
				"to": "00:07:42,780"
			},
			"offsets": {
				"from": 461940,
				"to": 462780
			},
			"text": "このオーバーはこちらから"
		},
		{
			"timestamps": {
				"from": "00:07:42,780",
				"to": "00:07:43,720"
			},
			"offsets": {
				"from": 462780,
				"to": 463720
			},
			"text": "こちらから"
		}
	]
}
