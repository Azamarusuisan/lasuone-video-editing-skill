			},
			"offsets": {
				"from": 0,
				"to": 8060
			},
			"text": "ええええええええ 今日はでしょをよりですそれじゃ今日の会場もっとこそが入るということで"
		},
		{
			"timestamps": {
				"from": "00:00:08,060",
				"to": "00:00:14,680"
			},
			"offsets": {
				"from": 8060,
				"to": 14680
			},
			"text": "えっと前回転軸なんかこの前2つで何しようかな もう倒していると今こんな感じの事業を"
		},
		{
			"timestamps": {
				"from": "00:00:14,680",
				"to": "00:00:17,280"
			},
			"offsets": {
				"from": 14680,
				"to": 17280
			},
			"text": "あのー"
		},
		{
			"timestamps": {
				"from": "00:00:18,840",
				"to": "00:00:24,580"
			},
			"offsets": {
				"from": 18840,
				"to": 24580
			},
			"text": "てくれさんにきっ アローブルーが行っていますでみまくますよ"
		},
		{
			"timestamps": {
				"from": "00:00:24,580",
				"to": "00:00:32,440"
			},
			"offsets": {
				"from": 24580,
				"to": 32440
			},
			"text": "今つを連帯もしくは開催とこの設定をしていっ スキルコミキを皆さんなんかまたないもう一つ思い出たいことがありがい時代本質のサービスを"
		},
		{
			"timestamps": {
				"from": "00:00:32,440",
				"to": "00:00:37,620"
			},
			"offsets": {
				"from": 32440,
				"to": 37620
			},
			"text": "言われれば良いと思う 栄光栄株式会社絶対で今めちゃくちゃ流行っているクロードコード"
		},
		{
			"timestamps": {
				"from": "00:00:37,620",
				"to": "00:00:44,840"
			},
			"offsets": {
				"from": 37620,
				"to": 44840
			},
			"text": "まあクロードの中では様々なサービスなんですけれども 今では今世の中で開発しているほとんどがクロードコードと言うなって開発しています"
		},
		{
			"timestamps": {
				"from": "00:00:44,840",
				"to": "00:00:51,680"
			},
			"offsets": {
				"from": 44840,
				"to": 51680
			},
			"text": "日本で一番分かりやすく2ヶ月で学べるというクロード系フォードの研修のサービスを 3月からスタートさせていただきまして"
		},
		{
			"timestamps": {
				"from": "00:00:51,680",
				"to": "00:00:58,280"
			},
			"offsets": {
				"from": 51680,
				"to": 58280
			},
			"text": "上場企業を踏まえて大きい価値の方で踏まえて今3社ことの申し込みを頂いておりまして これから一気に全国展開をしていこうというふうに思っています"
		},
		{
			"timestamps": {
				"from": "00:00:58,280",
				"to": "00:01:00,840"
			},
			"offsets": {
				"from": 58280,
				"to": 60840
			},
			"text": "いったでしょうか それが60万2ヶ月で60万"
		},
		{
			"timestamps": {
				"from": "00:01:00,840",
				"to": "00:01:08,800"
			},
			"offsets": {
				"from": 60840,
				"to": 68800
			},
			"text": "なるほどね ai 時代の本質はクロードコードで結局業務を自動化しちゃえば 何でもできるのでそれ以外あんまり本来は学ぶ必要がないというか"
		},
		{
			"timestamps": {
				"from": "00:01:08,800",
				"to": "00:01:15,800"
			},
			"offsets": {
				"from": 68800,
				"to": 75800
			},
			"text": "ある人はあるんですが大体会社に23人クロードコードがちゃんと使える人材がいたら 大体のことができるので弊社の皆さんに僕はいつも知るのは a 本質はそこですよ"
		},
		{
			"timestamps": {
				"from": "00:01:15,800",
				"to": "00:01:22,800"
			},
			"offsets": {
				"from": 75800,
				"to": 82800
			},
			"text": "ただこれなかなか教えられることがなかったのでクロードコードの研修を作りました なるほど今3社やってると"
		},
		{
			"timestamps": {
				"from": "00:01:22,800",
				"to": "00:01:25,800"
			},
			"offsets": {
				"from": 82800,
				"to": 85800
			},
			"text": "はい なるほどまだあと何社受けられるんですか"
		},
		{
			"timestamps": {
				"from": "00:01:25,800",
				"to": "00:01:30,800"
			},
			"offsets": {
				"from": 85800,
				"to": 90800
			},
			"text": "あととりあえず3月ではあと3社ぐらい もう少しブラッシュアップしたりとか"
		},
		{
			"timestamps": {
				"from": "00:01:30,800",
				"to": "00:01:35,800"
			},
			"offsets": {
				"from": 90800,
				"to": 95800
			},
			"text": "もっとこうよくできるんじゃないかというところもあるので一旦は3社だと あと3社しか撮ってないの?"
		},
		{
			"timestamps": {
				"from": "00:01:35,800",
				"to": "00:01:39,800"
			},
			"offsets": {
				"from": 95800,
				"to": 99800
			},
			"text": "へー 了解です 最初の本当に本質として学んでいただくのがいいかなという感じでおります"
		},
		{
			"timestamps": {
				"from": "00:01:39,800",
				"to": "00:01:42,800"
			},
			"offsets": {
				"from": 99800,
				"to": 102800
			},
			"text": "なるほど こんな3社しか受けられなかったらさ"
		},
		{
			"timestamps": {
				"from": "00:01:42,800",
				"to": "00:01:45,800"
			},
			"offsets": {
				"from": 102800,
				"to": 105800
			},
			"text": "もうコモンラインでポチッとまで決まるんだろう こんな動画撮んだ人ってさ"
		},
		{
			"timestamps": {
				"from": "00:01:45,800",
				"to": "00:01:47,800"
			},
			"offsets": {
				"from": 105800,
				"to": 107800
			},
			"text": "もう決まっちゃうじゃんこれ 僕もそう思うんですけど"
		},
		{
			"timestamps": {
				"from": "00:01:47,800",
				"to": "00:01:50,800"
			},
			"offsets": {
				"from": 107800,
				"to": 110800
			},
			"text": "どうもこれ 意味ないね"
		},
		{
			"timestamps": {
				"from": "00:01:50,800",
				"to": "00:01:53,800"
			},
			"offsets": {
				"from": 110800,
				"to": 113800
			},
			"text": "全体も構想された頃には奪ってんじゃないかっていう感じはしますけど"
		},
		{
			"timestamps": {
				"from": "00:01:53,800",
				"to": "00:01:55,800"
			},
			"offsets": {
				"from": 113800,
				"to": 115800
			},
			"text": "はい 林さんのコープページに写真が載っていると"
		},
		{
			"timestamps": {
				"from": "00:01:55,800",
				"to": "00:01:57,800"
			},
			"offsets": {
				"from": 115800,
				"to": 117800
			},
			"text": "はい なんてわかりました"
		},
		{
			"timestamps": {
				"from": "00:01:57,800",
				"to": "00:01:59,800"
			},
			"offsets": {
				"from": 117800,
				"to": 119800
			},
			"text": "というわけでじゃあ ラスワンさんのサービスとしては"
		},
		{
			"timestamps": {
				"from": "00:01:59,800",
				"to": "00:02:01,800"
			},
			"offsets": {
				"from": 119800,
				"to": 121800
			},
			"text": "この6名2ヶ月間研修するサービスと"
		},
		{
			"timestamps": {
				"from": "00:02:01,800",
				"to": "00:02:05,800"
			},
			"offsets": {
				"from": 121800,
				"to": 125800
			},
			"text": "あともう もう月15万でっていうね"
		},
		{
			"timestamps": {
				"from": "00:02:05,800",
				"to": "00:02:07,800"
			},
			"offsets": {
				"from": 125800,
				"to": 127800
			},
			"text": "残りのあと2つのサービスも良かったら"
		},
		{
			"timestamps": {
				"from": "00:02:07,800",
				"to": "00:02:11,800"
			},
			"offsets": {
				"from": 127800,
				"to": 131800
			},
			"text": "オープンクルーに関しては まず構築だけであれば15万円で構築します"
		},
		{
			"timestamps": {
				"from": "00:02:11,800",
				"to": "00:02:15,800"
			},
			"offsets": {
				"from": 131800,
				"to": 135800
			},
			"text": "あとはその構築プラス事業の内容 コンサルをしていくというのが25万円で"
		},
		{
			"timestamps": {
				"from": "00:02:15,800",
				"to": "00:02:17,800"
			},
			"offsets": {
				"from": 135800,
				"to": 137800
			},
			"text": "バックにも全て込み込むのだけになります"
		},
		{
			"timestamps": {
				"from": "00:02:19,800",
				"to": "00:02:23,800"
			},
			"offsets": {
				"from": 139800,
				"to": 143800
			},
			"text": "このサービスと6名2ヶ月研修の60万円のサービスだ"
		},
		{
			"timestamps": {
				"from": "00:02:23,800",
