				"to": "00:00:07,780"
			},
			"offsets": {
				"from": 4420,
				"to": 7780
			},
			"text": "人生の本質とは何でしょうか"
		},
		{
			"timestamps": {
				"from": "00:00:07,780",
				"to": "00:00:11,360"
			},
			"offsets": {
				"from": 7780,
				"to": 11360
			},
			"text": "何ですか人生の本質は"
		},
		{
			"timestamps": {
				"from": "00:00:11,360",
				"to": "00:00:14,700"
			},
			"offsets": {
				"from": 11360,
				"to": 14700
			},
			"text": "いい仕事してうまい肉を食うことあるんじゃないですかね"
		},
		{
			"timestamps": {
				"from": "00:00:14,700",
				"to": "00:00:15,760"
			},
			"offsets": {
				"from": 14700,
				"to": 15760
			},
			"text": "その通りでございます"
		},
		{
			"timestamps": {
				"from": "00:00:15,760",
				"to": "00:00:20,860"
			},
			"offsets": {
				"from": 15760,
				"to": 20860
			},
			"text": "人生僕たちが何のために生まれに来ても"
		},
		{
			"timestamps": {
				"from": "00:00:20,860",
				"to": "00:00:26,280"
			},
			"offsets": {
				"from": 20860,
				"to": 26280
			},
			"text": "僕たちが関わる人々を幸せにしたいということでございますので"
		},
		{
			"timestamps": {
				"from": "00:00:26,280",
				"to": "00:00:29,180"
			},
			"offsets": {
				"from": 26280,
				"to": 29180
			},
			"text": "今日出会ったお縁に感謝して"
		},
		{
			"timestamps": {
