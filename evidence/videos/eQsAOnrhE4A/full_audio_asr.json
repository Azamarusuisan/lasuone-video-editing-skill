				"to": "00:00:15,900"
			},
			"offsets": {
				"from": 12420,
				"to": 15900
			},
			"text": "2日間で20万なんですけど、めちゃくちゃ好評をいただいているので"
		},
		{
			"timestamps": {
				"from": "00:00:15,900",
				"to": "00:00:20,600"
			},
			"offsets": {
				"from": 15900,
				"to": 20600
			},
			"text": "今日はこの若者たちが研修をしていますが、どんな研修をやっているんでしょうか?"
		},
		{
			"timestamps": {
				"from": "00:00:21,660",
				"to": "00:00:25,460"
			},
			"offsets": {
				"from": 21660,
				"to": 25460
			},
			"text": "2日間で7時間ずつ教えて、14時間で研修しているんですけど"
		},
		{
			"timestamps": {
				"from": "00:00:25,620",
				"to": "00:00:30,660"
			},
			"offsets": {
				"from": 25620,
				"to": 30660
			},
			"text": "本当にその2日間の研修を終えれば、社のツールを作成できたりとか"
