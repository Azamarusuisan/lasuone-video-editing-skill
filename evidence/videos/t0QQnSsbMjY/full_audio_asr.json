			"offsets": {
				"from": 0,
				"to": 2660
			},
			"text": "このチャンネルは僕の人間観察バラエティでございます"
		},
		{
			"timestamps": {
				"from": "00:00:02,660",
				"to": "00:00:04,480"
			},
			"offsets": {
				"from": 2660,
				"to": 4480
			},
			"text": "オンラインギャンブル並びフォートバクの"
		},
		{
			"timestamps": {
				"from": "00:00:04,480",
				"to": "00:00:06,620"
			},
			"offsets": {
				"from": 4480,
				"to": 6620
			},
			"text": "勧誘推奨は一切行っておりません"
		},
		{
			"timestamps": {
				"from": "00:00:06,620",
				"to": "00:00:08,160"
			},
			"offsets": {
				"from": 6620,
				"to": 8160
			},
			"text": "日本でのギャンブルはダメだっちゃよ"
		},
		{
			"timestamps": {
				"from": "00:00:08,160",
				"to": "00:00:09,620"
			},
			"offsets": {
				"from": 8160,
				"to": 9620
			},
			"text": "それでは本編をご覧ください"
		},
		{
			"timestamps": {
				"from": "00:00:09,620",
				"to": "00:00:12,080"
			},
			"offsets": {
				"from": 9620,
				"to": 12080
			},
			"text": "続けです"
		},
		{
			"timestamps": {
				"from": "00:00:12,080",
				"to": "00:00:13,300"
			},
			"offsets": {
				"from": 12080,
				"to": 13300
			},
			"text": "いい感じだったんだよね"
		},
		{
			"timestamps": {
				"from": "00:00:13,300",
				"to": "00:00:15,840"
			},
			"offsets": {
				"from": 13300,
				"to": 15840
			},
			"text": "そんなに失敗とは思っていないが"
		},
		{
			"timestamps": {
				"from": "00:00:15,840",
				"to": "00:00:17,560"
			},
			"offsets": {
				"from": 15840,
				"to": 17560
			},
			"text": "この後もう一個出てきましょう"
		},
		{
			"timestamps": {
				"from": "00:00:17,560",
				"to": "00:00:19,440"
			},
			"offsets": {
				"from": 17560,
				"to": 19440
			},
			"text": "でも2連続インまでしてくるね"
		},
		{
			"timestamps": {
				"from": "00:00:19,440",
				"to": "00:00:19,640"
			},
			"offsets": {
				"from": 19440,
				"to": 19640
			},
			"text": "はい"
		},
		{
			"timestamps": {
				"from": "00:00:19,640",
				"to": "00:00:21,020"
			},
			"offsets": {
				"from": 19640,
				"to": 21020
			},
			"text": "お疲れ様です"
		},
		{
			"timestamps": {
				"from": "00:00:21,020",
				"to": "00:00:28,860"
			},
			"offsets": {
				"from": 21020,
				"to": 28860
			},
			"text": "パープルパープル"
		},
		{
			"timestamps": {
