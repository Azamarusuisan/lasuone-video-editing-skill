	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:03,320"
			},
			"offsets": {
				"from": 0,
				"to": 3320
			},
			"text": "おはようございます。高尾山、テイツー、2日連続登りに来ました。"
		},
		{
			"timestamps": {
				"from": "00:00:04,180",
				"to": "00:00:09,960"
			},
			"offsets": {
				"from": 4180,
				"to": 9960
			},
			"text": "仏教には中道という言葉がございまして、この世の中は無であるという話なんですけれども、"
		},
		{
			"timestamps": {
				"from": "00:00:10,720",
				"to": "00:00:17,300"
			},
			"offsets": {
				"from": 10720,
				"to": 17300
			},
			"text": "その無の世界を自分が、例えばお金がなくなって悲しい人生だと思ったらその人生が確定するし、ポジティブについてもダメだと。"
		},
		{
			"timestamps": {
				"from": "00:00:18,260",
				"to": "00:00:22,200"
			},
			"offsets": {
				"from": 18260,
				"to": 22200
			},
			"text": "なのでここの中立を生きて、今自分がどこの位置にいるのかということを見直すことが大事だと。"
		},
		{
			"timestamps": {
				"from": "00:00:22,500",
				"to": "00:00:25,600"
			},
			"offsets": {
				"from": 22500,
				"to": 25600
			},
			"text": "これが仏教の教え中道です。だからなんだという話ですけれども、"
		},
		{
			"timestamps": {
				"from": "00:00:26,020",
				"to": "00:00:32,240"
			},
			"offsets": {
				"from": 26020,
				"to": 32240
			},
			"text": "やっぱり人生良い時も悪い時もあるので、しっかりと世のため人のため頑張って生きていくということがあるんじゃないでしょうか。"
		},
		{
			"timestamps": {
				"from": "00:00:32,640",
				"to": "00:00:39,620"
			},
			"offsets": {
				"from": 32640,
				"to": 39620
			},
			"text": "僕がガンブルで負けるのも全て世のためになっているということなので、またいっぱい稼いで世のため人のために頑張っていきたいなというふうに思っています。"
		},
		{
			"timestamps": {
				"from": "00:00:40,380",
				"to": "00:00:42,980"
			},
			"offsets": {
				"from": 40380,
				"to": 42980
			},
			"text": "それでは、次です。2日目登っていきましょう。"
		},
		{
			"timestamps": {
				"from": "00:00:45,420",
				"to": "00:00:47,440"
			},
			"offsets": {
				"from": 45420,
				"to": 47440
			},
			"text": "これが成功者の景色です。"
		},
		{
			"timestamps": {
				"from": "00:00:49,540",
				"to": "00:00:51,940"
			},
			"offsets": {
				"from": 49540,
				"to": 51940
			},
			"text": "しかし、曇っています。"
		},
		{
			"timestamps": {
				"from": "00:00:52,760",
				"to": "00:00:53,380"
			},
			"offsets": {
				"from": 52760,
				"to": 53380
			},
			"text": "なぜならば、"
		},
		{
			"timestamps": {
				"from": "00:00:56,020",
				"to": "00:01:00,940"
			},
			"offsets": {
				"from": 56020,
				"to": 60940
			},
			"text": "先週、競馬で負けたら"
		},
		{
			"timestamps": {
				"from": "00:01:00,940",
				"to": "00:01:07,760"
			},
			"offsets": {
				"from": 60940,
				"to": 67760
			},
			"text": "溜まったうんちはバイオ燃料になるので、ちゃんとこまめにうんちは掃除した方がいい。"
		},
		{
			"timestamps": {
				"from": "00:01:09,100",
				"to": "00:01:09,820"
			},
			"offsets": {
				"from": 69100,
				"to": 69820
			},
			"text": "これ仕事ですか?"
		},
		{
			"timestamps": {
				"from": "00:01:10,200",
				"to": "00:01:10,800"
			},
			"offsets": {
				"from": 70200,
				"to": 70800
			},
			"text": "これ仕事です。"
		},
		{
			"timestamps": {
				"from": "00:01:14,660",
				"to": "00:01:17,000"
			},
			"offsets": {
				"from": 74660,
				"to": 77000
			},
			"text": "もう一回戦いくと、ここがタマゴッチです。"
		},
		{
			"timestamps": {
				"from": "00:01:19,500",
				"to": "00:01:20,500"
			},
			"offsets": {
				"from": 79500,
				"to": 80500
			},
			"text": "なにって書くの?"
		},
		{
			"timestamps": {
				"from": "00:01:21,040",
				"to": "00:01:22,200"
			},
			"offsets": {
				"from": 81040,
				"to": 82200
			},
			"text": "で、一番ここに来ると、これは"
		},
		{
			"timestamps": {
				"from": "00:01:24,320",
				"to": "00:01:24,980"
			},
			"offsets": {
				"from": 84320,
				"to": 84980
			},
			"text": "地球です。"
		},
		{
			"timestamps": {
				"from": "00:01:25,520",
				"to": "00:01:26,020"
			},
			"offsets": {
				"from": 85520,
				"to": 86020
			},
			"text": "いきなり。"
		},
		{
			"timestamps": {
				"from": "00:01:29,320",
				"to": "00:01:32,500"
			},
			"offsets": {
				"from": 89320,
				"to": 92500
			},
			"text": "タクシーと、じゃあこれから年収チャンネルの撮影に行ってきますので、"
		},
		{
			"timestamps": {
				"from": "00:01:32,500",
				"to": "00:01:33,000"
			},
			"offsets": {
				"from": 92500,
				"to": 93000
			},
			"text": "いってらっしゃいませ。"
		},
		{
			"timestamps": {
				"from": "00:01:33,460",
				"to": "00:01:34,240"
			},
			"offsets": {
				"from": 93460,
				"to": 94240
			},
			"text": "よろしくお願いします。"
		},
		{
			"timestamps": {
				"from": "00:01:34,720",
				"to": "00:01:37,220"
			},
			"offsets": {
				"from": 94720,
				"to": 97220
			},
			"text": "たまこっち、何日持つか、みんなコメントで教えてね。"
		},
		{
			"timestamps": {
				"from": "00:01:39,140",
				"to": "00:01:39,540"
			},
			"offsets": {
				"from": 99140,
				"to": 99540
			},
			"text": "ありがとうございました。"
		}
	]
}
