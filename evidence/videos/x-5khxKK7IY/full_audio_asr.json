			},
			"offsets": {
				"from": 91820,
				"to": 95320
			},
			"text": "コントランドくん ギリシャンってギリシャンくん"
		},
		{
			"timestamps": {
				"from": "00:01:35,320",
				"to": "00:01:41,380"
