			},
			"offsets": {
				"from": 9620,
				"to": 14020
			},
			"text": "ただ12社と言ってもですよ僕の顧問って冷静に考えたんですよ 年100番"
		},
		{
			"timestamps": {
				"from": "00:00:14,020",
				"to": "00:00:18,000"
			},
			"offsets": {
				"from": 14020,
				"to": 18000
			},
			"text": "効果が出なかったら一生やります冷静に考えたら月8万円なんですよ はい"
		},
		{
			"timestamps": {
				"from": "00:00:18,000",
				"to": "00:00:23,740"
			},
			"offsets": {
				"from": 18000,
				"to": 23740
			},
			"text": "で一括で必ずもらっていい 一括でもらって100万円この前の競馬とかに100万なくなっちゃう"
		},
		{
			"timestamps": {
				"from": "00:00:23,740",
				"to": "00:00:26,400"
			},
			"offsets": {
				"from": 23740,
				"to": 26400
			},
			"text": "はいなくなりました"
		},
		{
			"timestamps": {
				"from": "00:00:26,400",
				"to": "00:00:30,460"
			},
			"offsets": {
				"from": 26400,
				"to": 30460
			},
			"text": "永遠と労働の責務が一生残るって言う ただ俺はこれ労働だと思ってない"
		},
		{
			"timestamps": {
				"from": "00:00:30,460",
				"to": "00:00:37,640"
			},
			"offsets": {
				"from": 30460,
				"to": 37640
			},
			"text": "ai じゃあ大事なことは仲間ですよ 仲間では人脈とか仲間とかそれはすごい大事なんで"
		},
		{
			"timestamps": {
				"from": "00:00:37,640",
				"to": "00:00:44,300"
			},
			"offsets": {
				"from": 37640,
				"to": 44300
			},
			"text": "仲間が欲しい仲間が欲しい 今度はこれまでマジ心から覆って仲間を知っ"
		},
		{
			"timestamps": {
				"from": "00:00:44,300",
				"to": "00:00:50,740"
			},
			"offsets": {
				"from": 44300,
				"to": 50740
			},
			"text": "ちょっとだけお金が欲しいどれがあると思う どれくらいだと思う"
		},
		{
			"timestamps": {
				"from": "00:00:51,560",
				"to": "00:00:56,620"
			},
			"offsets": {
				"from": 51560,
				"to": 56620
			},
			"text": "7373 まあ912位ですね仲間星9年はい"
		},
		{
			"timestamps": {
				"from": "00:00:56,620",
				"to": "00:01:00,620"
			},
			"offsets": {
				"from": 56620,
				"to": 60620
			},
			"text": "あれがお信じ全然お金は正直 はいこれいらないんだけど"
		},
		{
			"timestamps": {
				"from": "00:01:00,620",
				"to": "00:01:02,620"
			},
			"offsets": {
				"from": 60620,
				"to": 62620
			},
			"text": "一応さっ ねっ"
		},
		{
			"timestamps": {
				"from": "00:01:02,620",
				"to": "00:01:05,860"
			},
			"offsets": {
				"from": 62620,
				"to": 65860
			},
			"text": "はいねそれじゃあ"
		},
		{
			"timestamps": {
				"from": "00:01:05,860",
				"to": "00:01:09,920"
			},
			"offsets": {
				"from": 65860,
				"to": 69920
			},
			"text": "袋について話していないん 黒靴いっぱいあるんですけども"
		},
		{
			"timestamps": {
				"from": "00:01:09,920",
				"to": "00:01:15,260"
			},
			"offsets": {
				"from": 69920,
				"to": 75260
			},
			"text": "袋は袋ですね苦労しない なんで池袋に嬉しい"
		},
		{
			"timestamps": {
				"from": "00:01:15,260",
				"to": "00:01:21,320"
			},
			"offsets": {
				"from": 75260,
				"to": 81320
			},
			"text": "苦労っていうのはそれから近くに置いておくと苦労しないよ 言われているんです僕は全然が苦労ですよ"
		},
		{
			"timestamps": {
				"from": "00:01:21,320",
				"to": "00:01:23,320"
			},
			"offsets": {
				"from": 81320,
				"to": 83320
			},
			"text": "えっ えっ"
		},
		{
			"timestamps": {
